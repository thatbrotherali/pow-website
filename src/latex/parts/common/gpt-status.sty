% gpt-status.sty -- claim-status marks for the second edition of Graviton Pressure Theory.
% \argm{..} Argued: solid blue underline.   \hypm{..} Hypothesis: dashed orange underline.
% \openm{..} Open: dotted grey underline and a small circle.
% argbar / hypbar / openbar: a whole passage, with a bar of the same style in the left margin.
% \statuskey prints the key.  Each mark also carries its status word as invisible text,
% so that copied text, screen readers and AI readers see "[Argued]" etc.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{gpt-status}[2026/11/20 GPT claim-status marks]
\RequirePackage{xcolor}
\RequirePackage{tikz}
\RequirePackage[framemethod=TikZ]{mdframed}
\RequirePackage{pdfrender}
\definecolor{gptarg}{HTML}{1F5FAD}
\definecolor{gpthyp}{HTML}{C8650A}
\definecolor{gptopen}{HTML}{8A8A8A}
\newcommand{\gpt@hidden}[1]{\rlap{\textpdfrender{TextRenderingMode=Invisible}{\,[#1]}}}
% Underlines from ulem, so that a marked passage may break across lines.
\RequirePackage[normalem]{ulem}
\renewcommand{\ULthickness}{0.6pt}
% Each mark repeats a small coloured piece under the text; the text keeps its own colour.
\newcommand{\gpt@solid}{\textcolor{gptarg}{\rule[-2.2pt]{2pt}{0.6pt}}}
\newcommand{\gpt@dash}{\textcolor{gpthyp}{\rule[-2.2pt]{2.6pt}{0.6pt}\kern1.6pt}}
\newcommand{\gpt@dot}{\textcolor{gptopen}{\rule[-2.2pt]{0.7pt}{0.7pt}\kern1.3pt}}
\newcommand{\argm}[1]{\bgroup\markoverwith{\gpt@solid}\ULon{#1}\gpt@hidden{Argued}}
\newcommand{\hypm}[1]{\bgroup\markoverwith{\gpt@dash}\ULon{#1}\gpt@hidden{Hypothesis}}
\newcommand{\openm}[1]{\bgroup\markoverwith{\gpt@dot}\ULon{#1}\gpt@hidden{Open}\,{\color{gptopen}$\circ$}}
% A figure caption whose drawing shows a proposal of GPT.
\providecommand{\hyptag}{\textit{(Hypothesis)}}
\newcommand{\gpt@bartag}[2]{{\sffamily\fontsize{6.5}{8}\selectfont\color{#1}\MakeUppercase{#2}\par}\vspace{2pt}}
\mdfdefinestyle{gpt@bar}{topline=false,bottomline=false,rightline=false,leftline=true,
  linewidth=1.1pt,innerleftmargin=10pt,innerrightmargin=0pt,innertopmargin=2pt,innerbottommargin=2pt,
  leftmargin=-12pt,rightmargin=0pt,skipabove=8pt,skipbelow=6pt,backgroundcolor=white}
% The margin bar is drawn by hand so that each status keeps its line style, also across page breaks.
\newenvironment{argbar}{\begin{mdframed}[style=gpt@bar,leftline=false,singleextra={\draw[gptarg,line width=1.1pt] (O) -- (O|-P);},firstextra={\draw[gptarg,line width=1.1pt] (O) -- (O|-P);},secondextra={\draw[gptarg,line width=1.1pt] (O) -- (O|-P);},middleextra={\draw[gptarg,line width=1.1pt] (O) -- (O|-P);}]\gpt@bartag{gptarg}{Argued}\leavevmode\gpt@hidden{Argued: the passage that follows}\ignorespaces}{\end{mdframed}}
\newenvironment{hypbar}{\begin{mdframed}[style=gpt@bar,leftline=false,singleextra={\draw[gpthyp,line width=1.1pt,dash pattern=on 4pt off 2.5pt] (O) -- (O|-P);},firstextra={\draw[gpthyp,line width=1.1pt,dash pattern=on 4pt off 2.5pt] (O) -- (O|-P);},secondextra={\draw[gpthyp,line width=1.1pt,dash pattern=on 4pt off 2.5pt] (O) -- (O|-P);},middleextra={\draw[gpthyp,line width=1.1pt,dash pattern=on 4pt off 2.5pt] (O) -- (O|-P);}]\gpt@bartag{gpthyp}{Hypothesis}\leavevmode\gpt@hidden{Hypothesis: the passage that follows}\ignorespaces}{\end{mdframed}}
\newenvironment{openbar}{\begin{mdframed}[style=gpt@bar,leftline=false,singleextra={\draw[gptopen,line width=1.1pt,dash pattern=on 1pt off 2pt] (O) -- (O|-P);},firstextra={\draw[gptopen,line width=1.1pt,dash pattern=on 1pt off 2pt] (O) -- (O|-P);},secondextra={\draw[gptopen,line width=1.1pt,dash pattern=on 1pt off 2pt] (O) -- (O|-P);},middleextra={\draw[gptopen,line width=1.1pt,dash pattern=on 1pt off 2pt] (O) -- (O|-P);}]\gpt@bartag{gptopen}{Open}\leavevmode\gpt@hidden{Open: the passage that follows}\ignorespaces}{\end{mdframed}}
\newcommand{\statuskey}{%
  \par\medskip\noindent\fcolorbox{black!35}{black!3}{\begin{minipage}{\dimexpr\linewidth-2\fboxsep-2\fboxrule}\small\sffamily
  \textbf{How to read the marks.} Claims about Graviton Pressure Theory are marked by how far they are established.\par\smallskip
  \begin{tabular}{@{}p{0.27\linewidth}p{0.66\linewidth}@{}}
  Established & No mark. Accepted, measured physics.\\
  \argm{Argued} & Solid blue underline. A conclusion this framework argues in detail, which readers can check.\\
  \hypm{Hypothesis} & Dashed orange underline. A proposal of GPT, not yet tested.\\
  \openm{Open} & Dotted grey underline and $\circ$. A question not yet answered; work still owed.
  \end{tabular}\par\smallskip
  A whole passage with one status carries a bar of the same style in the left margin. The marks are drawn in distinct line styles, so they read in black and white.
  \end{minipage}}\par\medskip}
% \fn{key}: a citation as a footnote.  Inside a box use \footnotemark and \footnotetext after it.
\newcommand{\fn}[1]{\footnote{\citealp{#1}.}}
\endinput
